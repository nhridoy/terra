# Server Configuration
TERMVAULT_PORT=8080
TERMVAULT_HOST=0.0.0.0

# Base URL for OAuth callbacks
BASE_URL=http://localhost:8080

# Database (SQLite for development)
DATABASE_URL=sqlite:///data/termvault.db

# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/termvault

# For MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/termvault

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=24h

# OAuth Providers (configure your own)
# GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitLab
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=

# Microsoft (Azure AD)
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Bitbucket
OAUTH_BITBUCKET_CLIENT_ID=
OAUTH_BITBUCKET_CLIENT_SECRET=
