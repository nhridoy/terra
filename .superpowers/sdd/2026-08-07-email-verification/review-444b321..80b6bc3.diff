 func parseIntSafe(s string, fallback int) (int, error) {
 	var n int
 	_, err := fmt.Sscanf(s, "%d", &n)
 	if err != nil {
 		return fallback, err
 	}
 	return n, nil
 }
+
+func parseBoolEnv(key string, fallback bool) bool {
+	v := strings.ToLower(strings.TrimSpace(os.Getenv(key)))
+	switch v {
+	case "true", "1", "yes":
+		return true
+	case "false", "0", "no":
+		return false
+	}
+	return fallback
+}
