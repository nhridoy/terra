 func hashToken(token string) string {
 	h := sha256.Sum256([]byte(token))
 	return base64.RawStdEncoding.EncodeToString(h[:])
 }
 
 func deref(s *string) string {
 	if s == nil {
 		return ""
 	}
 	return *s
